{
  "$schema": "http://json.schemastore.org/template",
  "author": "Sonam Jamtsho",
  "name": "REST API Template",
  "classifications": [ "Web", "API", "Clean Architecture" ],
  "identity": "Sonam.RestApiTemplate.Api",
  "groupIdentity": "Sonam.RestApiTemplate",
  "shortName": "sonam-api",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "RestApiTemplate",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
